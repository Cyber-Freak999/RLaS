  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Check latency p95 / p99 by replica",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(rlas_check_duration_seconds_bucket[$__rate_interval]))) * 1000",
          "legendFormat": "p95 {{instance}}",
          "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (instance, le) (rate(rlas_check_duration_seconds_bucket[$__rate_interval]))) * 1000",
          "legendFormat": "p99 {{instance}}",
          "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Checks per second by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, allowed) (rate(rlas_checks_total[$__rate_interval]))",
          "legendFormat": "{{instance}} allowed={{allowed}}",
          "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "showPoints": "never", "spanNulls": true },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Circuit breaker state",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rlas_circuit_breaker_open)",
          "legendFormat": "breaker open (1) / closed (0)",
          "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" }
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }, "min": 0, "max": 1, "unit": "bool" },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Degraded responses per second (fail-open active)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(rlas_checks_total{degraded=\"true\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "showPoints": "never", "spanNulls": true },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Streams consumer lag (entries / pending)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" },
      "targets": [
        {
          "refId": "A",
          "expr": "rlas_stream_entries",
          "legendFormat": "stream length (XLEN)",
          "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" }
        },
        {
          "refId": "B",
          "expr": "rlas_stream_pending",
          "legendFormat": "pending (XPENDING)",
          "datasource": { "type": "prometheus", "uid": "rlas-prometheus-ds" }
        }
      ],
      "fieldConfig": {
        "defaults": {
