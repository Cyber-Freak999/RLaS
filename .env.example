ADMIN_BEARER_TOKEN=changeme
REDIS_SENTINEL_ADDRS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_MASTER_NAME=mymaster
TIMESCALE_DSN=postgres://timescale:timescale@timescaledb:5432/rlas?sslmode=disable
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_SCRAPE_INTERVAL=10s

# TimescaleDB container credentials. compose builds control-plane's
# TIMESCALE_DSN from these; TIMESCALE_DSN above is the stand-alone value.
POSTGRES_USER=timescale
POSTGRES_PASSWORD=timescale
POSTGRES_DB=rlas

# Optional
REDIS_PASSWORD=
RATE_LIMITER_PORT=8080
CONTROL_PLANE_PORT=8081
SHUTDOWN_TIMEOUT=10s
